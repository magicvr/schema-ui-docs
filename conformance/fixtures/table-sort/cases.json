  "cases": [
    {
      "id": "v24-compat-no-sort-fields-click-ignored",
      "protocolVersion": "2.9",
      "category": "table-sort",
      "input": {
        "meta": {
          "protocolVersion": "2.4"
        },
        "table": {
          "columns": [
            {
              "field": "id",
              "label": "ID"
            },
            {
              "field": "name",
              "label": "Name"
            }
          ],
          "pagination": {
            "mode": "server",
            "pageSize": 20
          }
        },
        "state": {
          "filters": {},
          "page": 1,
          "pageSize": 20,
          "sort": null
        },
        "event": {
          "type": "clickSort",
          "field": "name"
        },
        "baseUrl": "/orders"
      },
      "expected": {
        "ok": true,
        "protocolSortInteraction": false,
        "state": {
          "filters": {},
          "page": 1,
          "pageSize": 20,
          "sort": null
        },
        "url": "/orders?page=1&pageSize=20"
      }
    },
