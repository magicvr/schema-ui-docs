      "id": "canonical-object-key-sort",
      "protocolVersion": "2.8",
      "category": "host-conformance-claim",
      "input": { "operation": "canonicalize", "value": { "b": 1, "a": "x" } },
      "expected": { "canonical": "{\"a\":\"x\",\"b\":1}" }
    },
    {
      "id": "canonical-non-ascii-key-byte-order",
      "protocolVersion": "2.8",
      "category": "host-conformance-claim",
      "input": { "operation": "canonicalize", "value": { "键": "v", "a": "x" } },
      "expected": { "canonical": "{\"a\":\"x\",\"键\":\"v\"}" }
    },
    {
      "id": "canonical-string-array-sort",
      "protocolVersion": "2.8",
      "category": "host-conformance-claim",
      "input": { "operation": "canonicalize", "value": { "items": ["c", "a", "b"] } },
      "expected": { "canonical": "{\"items\":[\"a\",\"b\",\"c\"]}" }
