    {
      "id": "three-slots-project",
      "protocolVersion": "2.7",
      "category": "app-navigation",
      "input": {
        "operation": "project",
        "navigation": {
          "top": [
            {
              "pageRef": "home",
              "label": "Home",
              "icon": "home"
            }
          ],
          "sidebar": [
            {
              "pageRef": "orders",
              "label": "Orders",
              "icon": "orders"
            },
            {
              "label": "Admin",
              "icon": "settings",
              "items": [
                {
                  "pageRef": "orders-new",
                  "label": "Create",
                  "permissions": {
                    "view": "$context.user.roles contains \"admin\""
                  }
                }
              ]
            },
            {
              "pageRef": "orders-detail",
              "label": "Hidden feature",
              "visibleWhen": {
                "when": "$context.features.beta == true"
              }
            }
          ],
          "user": [
            {
              "url": "/profile",
              "label": "Profile"
            },
            {
              "url": "/logout",
              "label": "Logout",
              "icon": "logout"
            }
          ]
        },
        "pages": [
          {
            "pageId": "home",
            "title": "Home",
            "schemaUrl": "/api/schema/home",
            "route": "/home"
          },
          {
            "pageId": "orders",
            "title": "Orders",
            "schemaUrl": "/api/schema/orders",
            "route": "/orders"
          },
          {
            "pageId": "orders-new",
            "title": "New Order",
            "schemaUrl": "/api/schema/orders-new",
            "route": "/orders/new"
          },
          {
            "pageId": "orders-detail",
            "title": "Order Detail",
            "schemaUrl": "/api/schema/orders/{id}",
            "route": "/orders/{id}"
          }
        ],
        "context": {
          "user": {
            "id": "1",
            "name": "A",
            "roles": [
              "admin"
            ]
          },
          "features": {
            "beta": true
          }
        },
        "path": "/orders",
        "iconRegistry": [
          "home",
          "orders",
          "settings",
          "logout"
        ]
      },
      "expected": {
        "ok": true,
        "slots": {
          "top": [
            {
              "type": "link",
              "pageRef": "home",
              "label": "Home",
              "icon": "home",
              "iconOptional": true,
              "active": false,
              "iconRendered": true
            }
          ],
          "sidebar": [
            {
              "type": "link",
              "pageRef": "orders",
              "label": "Orders",
              "icon": "orders",
              "iconOptional": true,
              "active": true,
              "iconRendered": true
            },
            {
              "type": "group",
              "items": [
                {
                  "type": "link",
                  "pageRef": "orders-new",
                  "label": "Create",
                  "active": false
                }
              ],
              "label": "Admin",
              "icon": "settings",
              "iconRendered": true
            },
            {
              "type": "link",
              "pageRef": "orders-detail",
              "label": "Hidden feature",
              "active": false
            }
          ],
          "user": [
            {
              "type": "link",
              "url": "/profile",
              "label": "Profile",
              "active": false
            },
            {
              "type": "link",
              "url": "/logout",
              "label": "Logout",
              "icon": "logout",
              "iconOptional": true,
              "active": false,
              "iconRendered": true
            }
          ]
        }
      }
    },
