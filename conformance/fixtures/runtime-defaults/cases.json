{
  "fixtureVersion": "1.0",
  "category": "runtime-defaults",
  "cases": [
    {
      "id": "network-page-requires-base-url",
      "protocolVersion": "2.9",
      "category": "runtime-defaults",
      "input": {
        "kind": "requestConfig",
        "requiresNetwork": true
      },
      "expected": {
        "ok": false,
        "code": "MISSING_BASE_URL"
      }
    },
    {
      "id": "static-page-does-not-require-base-url",
      "protocolVersion": "2.9",
      "category": "runtime-defaults",
      "input": {
        "kind": "requestConfig",
        "requiresNetwork": false
      },
      "expected": {
        "ok": true
      }
    },
    {
      "id": "data-ref-method-default-materialized",
      "protocolVersion": "2.9",
      "category": "runtime-defaults",
      "input": {
        "kind": "defaults",
        "target": "dataRef",
        "value": {
          "url": "/orders"
        }
      },
      "expected": {
        "ok": true,
        "value": {
          "url": "/orders",
          "method": "GET"
        }
      }
    },
    {
      "id": "upload-defaults-materialized",
      "protocolVersion": "2.9",
      "category": "runtime-defaults",
      "input": {
        "kind": "defaults",
        "target": "uploadAction",
        "value": {
          "url": "/upload"
        }
      },
      "expected": {
        "ok": true,
        "value": {
          "url": "/upload",
          "method": "POST",
          "retryPolicy": "never",
          "fieldName": "file",
          "multiple": false
        }
      }
    },
    {
      "id": "missing-required-prop-is-invalid-component",
      "protocolVersion": "2.9",
      "category": "runtime-defaults",
      "input": {
        "kind": "component",
        "type": "statCard",
        "installedTypes": [
          "statCard"
        ],
        "requiredProps": [
          "label",
          "valueField"
        ],
        "props": {
          "label": "Orders"
        }
      },
      "expected": {
        "ok": false,
        "code": "INVALID_COMPONENT",
        "path": "props.valueField"
      }
    },
    {
      "id": "uninstalled-extension-is-unknown-component",
      "protocolVersion": "2.9",
      "category": "runtime-defaults",
      "input": {
        "kind": "component",
        "type": "vendor.auditWidget",
        "installedTypes": [
          "table"
        ],
        "requiredProps": [],
        "props": {}
      },
      "expected": {
        "ok": false,
        "code": "UNKNOWN_COMPONENT_TYPE"
      }
    },
    {
      "id": "form-init-default-value-only",
      "protocolVersion": "2.9",
      "category": "runtime-defaults",
      "input": {
        "kind": "formFieldInit",
        "fields": [
          {
            "field": "name",
            "wire": "string",
            "defaultValue": "Ada"
          },
          {
            "field": "active",
            "wire": "boolean",
            "defaultValue": true
          },
          {
            "field": "tags",
            "wire": "array",
            "defaultValue": [
              "a"
            ]
          }
        ]
      },
      "expected": {
        "ok": true,
        "values": {
          "name": "Ada",
          "active": true,
          "tags": [
            "a"
          ]
        }
      }
    },
    {
      "id": "form-init-record-source-overrides-default",
      "protocolVersion": "2.9",
      "category": "runtime-defaults",
      "input": {
        "kind": "formFieldInit",
        "fields": [
          {
            "field": "name",
            "wire": "string",
            "defaultValue": "Ada"
          },
          {
            "field": "active",
            "wire": "boolean",
            "defaultValue": true
          }
        ],
        "recordValues": {
          "name": "Bob"
        }
      },
      "expected": {
        "ok": true,
        "values": {
          "name": "Bob",
          "active": true
        }
      }
    },
    {
      "id": "form-init-reaction-overrides-after-record",
      "protocolVersion": "2.9",
      "category": "runtime-defaults",
      "input": {
        "kind": "formFieldInit",
        "fields": [
          {
            "field": "name",
            "wire": "string",
            "defaultValue": "Ada"
          },
          {
            "field": "tier",
            "wire": "string",
            "defaultValue": "free"
          }
        ],
        "recordValues": {
          "name": "Bob",
          "tier": "pro"
        },
        "reactionWrites": [
          {
            "field": "tier",
            "value": "enterprise"
          }
        ]
      },
      "expected": {
        "ok": true,
        "values": {
          "name": "Bob",
          "tier": "enterprise"
        }
      }
    }
  ]
}
