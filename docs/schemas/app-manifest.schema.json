{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schema-ui.dev/schemas/app-manifest.schema.json",
  "title": "Schema-UI Application Manifest",
  "description": "M0 structural contract for app-level manifest (ADR-0025 / ADR-0026). Semantic rules (M1) and expression static checks (M3a) are enforced by auxiliary validators.",
  "type": "object",
  "required": ["protocolVersion", "requiredCapabilities", "app", "pages"],
  "additionalProperties": false,
  "properties": {
    "protocolVersion": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
      "description": "Manifest protocol MAJOR.MINOR; negotiates app-level capabilities only (D1a). App-manifest fieldset requires >= 2.5 (M1 PROTOCOL_VERSION_TOO_LOW); page meta.protocolVersion remains decoupled."
    },
    "requiredCapabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)*$"
      },
      "description": "Must include app.manifest; must include app.navigation when navigation key is present (M1). v2.8 起 ID 段内允许连字符（ADR-0034 机读语法增宽）。"
    },
    "app": {
      "type": "object",
      "required": ["appId"],
      "additionalProperties": false,
      "properties": {
        "appId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "name": { "type": "string", "minLength": 1 },
        "nameKey": { "type": "string", "minLength": 1 },
        "homePageRef": { "type": "string", "minLength": 1 },
        "logo": {
          "type": "object",
          "required": ["light"],
          "additionalProperties": false,
          "properties": {
            "light": { "$ref": "#/definitions/LogoUrl" },
            "dark": { "$ref": "#/definitions/LogoUrl" }
          }
        },
        "description": { "type": "string" },
        "descriptionKey": { "type": "string" }
      },
      "anyOf": [
        { "required": ["name"] },
        { "required": ["nameKey"] }
      ]
    },
    "pages": {
      "type": "array",
      "items": { "$ref": "#/definitions/PageEntry" }
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "top": {
          "type": "array",
          "items": { "$ref": "#/definitions/NavItem" }
        },
        "sidebar": {
          "type": "array",
          "items": { "$ref": "#/definitions/NavItem" }
        },
        "user": {
          "type": "array",
          "items": { "$ref": "#/definitions/NavItem" }
        }
      }
    }
  },
  "definitions": {
    "LogoUrl": {
      "type": "string",
      "description": "Site-relative path (^/(?!/)[^\\s\\\\]*$ without placeholders) or https: absolute URL",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^/(?!/)[^\\s\\\\{}]*$"
        },
        {
          "type": "string",
          "pattern": "^https://[^\\s\\\\]+$"
        }
      ]
    },
    "AppRelativePath": {
      "type": "string",
      "pattern": "^/(?!/)[^\\s\\\\]*$",
      "description": "Site-relative path (^/(?!/)[^\\s\\\\]*$). Resolve base depends on field: schemaUrl → API baseURL; route / nav url → application route root (09 D1b)."
    },
    "PageEntry": {
      "type": "object",
      "required": ["pageId", "schemaUrl", "route"],
      "additionalProperties": false,
      "properties": {
        "pageId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "titleKey": { "type": "string", "minLength": 1 },
        "schemaUrl": {
          "$ref": "#/definitions/AppRelativePath",
          "description": "Page schema GET path under API baseURL; may contain {name} bound from route (09 D1b)"
        },
        "route": {
          "$ref": "#/definitions/AppRelativePath",
          "description": "Application-route-root path template; may contain {name}; never joined with API baseURL (09 D1b)"
        },
        "returnIntentQueryKeys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9_]*$"
          },
          "description": "v2.8+（ADR-0036 / 10 §3.7）：认证恢复意图 allowlist 扩展，对当前注册页生效。M1 门控：出现该字段 ⇒ protocolVersion >= 2.8 且声明 host.failure-recovery capability，否则 PROTOCOL_VERSION_TOO_LOW / MISSING_REQUIRED_CAPABILITY。敏感 key（token 等）由 Host 消费端永久拒绝，不在此处拒绝（10 §3.7）。"
        }
      },
      "anyOf": [
        { "required": ["title"] },
        { "required": ["titleKey"] }
      ]
    },
    "IconName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "NavPermissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "view": { "type": "string", "minLength": 1 }
      }
    },
    "NavLink": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pageRef": { "type": "string", "minLength": 1 },
        "url": {
          "type": "string",
          "pattern": "^/(?!/)[^\\s\\\\{}]*$",
          "description": "Application-route-root relative path (no placeholders); not joined with API baseURL (09 D1b)"
        },
        "label": { "type": "string", "minLength": 1 },
        "labelKey": { "type": "string", "minLength": 1 },
        "icon": { "$ref": "#/definitions/IconName" },
        "visibleWhen": { "$ref": "node.schema.json#/definitions/VisibleWhen" },
        "permissions": { "$ref": "#/definitions/NavPermissions" }
      },
      "oneOf": [
        { "required": ["pageRef"] },
        { "required": ["url"] }
      ]
    },
    "NavGroup": {
      "type": "object",
      "required": ["items"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "labelKey": { "type": "string", "minLength": 1 },
        "icon": { "$ref": "#/definitions/IconName" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/NavLink" }
        },
        "visibleWhen": { "$ref": "node.schema.json#/definitions/VisibleWhen" },
        "permissions": { "$ref": "#/definitions/NavPermissions" }
      },
      "anyOf": [
        { "required": ["label"] },
        { "required": ["labelKey"] }
      ]
    },
    "NavItem": {
      "oneOf": [
        { "$ref": "#/definitions/NavLink" },
        { "$ref": "#/definitions/NavGroup" }
      ]
    }
  }
}
